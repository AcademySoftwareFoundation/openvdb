#
# OpenVDB package configuration.
#
# Usage:
#   find_package(OpenVDB CONFIG REQUIRED)
#   target_link_libraries(my_target PRIVATE OpenVDB::openvdb)
#
# Imported targets:
#   OpenVDB::openvdb         Shared library if installed, otherwise static
#   OpenVDB::openvdb_shared  Shared library, if installed
#   OpenVDB::openvdb_static  Static library, if installed
#
#   OpenVDB::openvdb_ax      Shared library if installed, otherwise static, with
#                            the openvdb_ax component
#   OpenVDB::openvdb_ax_shared, OpenVDB::openvdb_ax_static
#                            The AX libraries, if installed
#   OpenVDB::nanovdb         NanoVDB::nanovdb and OpenVDB::openvdb, with the
#                            nanovdb component
#
# Components:
#   openvdb                  The core library, always available
#   openvdb_ax               OpenVDB AX, if installed. Requires LLVM
#   nanovdb                  NanoVDB, found through its own NanoVDBConfig
#
# Variables:
#   OpenVDB_VERSION, OpenVDB_ABI

@PACKAGE_INIT@

# The installed Find modules (such as FindTBB) live next to this file
set(_openvdb_original_module_path ${CMAKE_MODULE_PATH})
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Like find_dependency, but restores CMAKE_MODULE_PATH before returning
# when a dependency is missing
macro(_openvdb_find_dependency dependency)
  set(_openvdb_find_arguments ${ARGN})
  if(OpenVDB_FIND_QUIETLY)
    list(APPEND _openvdb_find_arguments QUIET)
  endif()
  if(OpenVDB_FIND_REQUIRED)
    list(APPEND _openvdb_find_arguments REQUIRED)
  endif()
  find_package(${dependency} ${_openvdb_find_arguments})
  if(NOT ${dependency}_FOUND)
    set(CMAKE_MODULE_PATH ${_openvdb_original_module_path})
    set(OpenVDB_NOT_FOUND_MESSAGE
      "OpenVDB could not be found because dependency ${dependency} could not be found.")
    set(OpenVDB_FOUND FALSE)
    return()
  endif()
endmacro()

set(OpenVDB_ABI @OpenVDB_ABI@)

_openvdb_find_dependency(TBB @MINIMUM_TBB_VERSION@ COMPONENTS tbb)

if(@USE_IMATH_HALF@)
  _openvdb_find_dependency(Imath @MINIMUM_IMATH_VERSION@ CONFIG)
endif()

if(UNIX)
  _openvdb_find_dependency(Threads)
endif()

# zlib and zstd are private dependencies, but a static library does not carry
# them, so they are only needed when the static library was installed.
if(@OPENVDB_CORE_STATIC@)
  if(@USE_ZLIB@)
    _openvdb_find_dependency(ZLIB @MINIMUM_ZLIB_VERSION@)
  endif()

  if(@USE_ZSTD@)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/FindZstd.cmake")
      _openvdb_find_dependency(Zstd @MINIMUM_ZSTD_VERSION@)
    else()
      _openvdb_find_dependency(zstd @MINIMUM_ZSTD_VERSION@ CONFIG)
    endif()

    # The exported target links to the zstd target that was used at build
    # time. Provide that name if this zstd install uses a different one.
    set(_openvdb_zstd_exported_target "@OPENVDB_EXPORTED_ZSTD_TARGET@")
    if(NOT TARGET ${_openvdb_zstd_exported_target})
      foreach(_openvdb_zstd_candidate
          Zstd::zstd zstd::libzstd_static zstd::libzstd_shared zstd::libzstd)
        if(TARGET ${_openvdb_zstd_candidate})
          add_library(${_openvdb_zstd_exported_target} ALIAS ${_openvdb_zstd_candidate})
          break()
        endif()
      endforeach()
      unset(_openvdb_zstd_candidate)
    endif()
    unset(_openvdb_zstd_exported_target)
  endif()
endif()

set(CMAKE_MODULE_PATH ${_openvdb_original_module_path})
unset(_openvdb_original_module_path)
unset(_openvdb_find_arguments)

include("${CMAKE_CURRENT_LIST_DIR}/OpenVDBTargets.cmake")

if(NOT TARGET OpenVDB::openvdb)
  add_library(OpenVDB::openvdb INTERFACE IMPORTED)
  if(TARGET OpenVDB::openvdb_shared)
    set_target_properties(OpenVDB::openvdb PROPERTIES
      INTERFACE_LINK_LIBRARIES OpenVDB::openvdb_shared)
  else()
    set_target_properties(OpenVDB::openvdb PROPERTIES
      INTERFACE_LINK_LIBRARIES OpenVDB::openvdb_static)
  endif()
endif()

set(OpenVDB_openvdb_FOUND TRUE)

# OpenVDB AX installs its targets next to this file, if it was built
if("openvdb_ax" IN_LIST OpenVDB_FIND_COMPONENTS)
  set(OpenVDB_openvdb_ax_FOUND FALSE)

  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/OpenVDBAXTargets.cmake")
    set(_openvdb_find_arguments)
    if(OpenVDB_FIND_QUIETLY OR NOT OpenVDB_FIND_REQUIRED_openvdb_ax)
      list(APPEND _openvdb_find_arguments QUIET)
    endif()
    find_package(LLVM @MINIMUM_LLVM_VERSION@ CONFIG ${_openvdb_find_arguments})
    unset(_openvdb_find_arguments)

    if(LLVM_FOUND)
      include("${CMAKE_CURRENT_LIST_DIR}/OpenVDBAXTargets.cmake")

      # The LLVM headers come from the LLVM install used by the consumer
      foreach(_openvdb_ax_target openvdb_ax_shared openvdb_ax_static)
        if(TARGET OpenVDB::${_openvdb_ax_target})
          target_include_directories(OpenVDB::${_openvdb_ax_target}
            SYSTEM INTERFACE ${LLVM_INCLUDE_DIRS})
        endif()
      endforeach()
      unset(_openvdb_ax_target)

      if(NOT TARGET OpenVDB::openvdb_ax)
        add_library(OpenVDB::openvdb_ax INTERFACE IMPORTED)
        if(TARGET OpenVDB::openvdb_ax_shared)
          set_target_properties(OpenVDB::openvdb_ax PROPERTIES
            INTERFACE_LINK_LIBRARIES OpenVDB::openvdb_ax_shared)
        else()
          set_target_properties(OpenVDB::openvdb_ax PROPERTIES
            INTERFACE_LINK_LIBRARIES OpenVDB::openvdb_ax_static)
        endif()
      endif()
      set(OpenVDB_openvdb_ax_FOUND TRUE)
    endif()
  endif()
endif()

# NanoVDB installs its own package config. This runs after OpenVDB::openvdb
# exists, so NanoVDBConfig does not look for OpenVDB again.
if("nanovdb" IN_LIST OpenVDB_FIND_COMPONENTS)
  set(_openvdb_find_arguments)
  if(OpenVDB_FIND_QUIETLY OR NOT OpenVDB_FIND_REQUIRED_nanovdb)
    list(APPEND _openvdb_find_arguments QUIET)
  endif()
  find_package(NanoVDB CONFIG ${_openvdb_find_arguments}
    HINTS "${CMAKE_CURRENT_LIST_DIR}/../NanoVDB")
  unset(_openvdb_find_arguments)

  # OpenVDB::nanovdb always links the core library, even when NanoVDB was
  # built without NANOVDB_USE_OPENVDB
  if(NanoVDB_FOUND)
    if(NOT TARGET OpenVDB::nanovdb)
      add_library(OpenVDB::nanovdb INTERFACE IMPORTED)
      set_target_properties(OpenVDB::nanovdb PROPERTIES
        INTERFACE_LINK_LIBRARIES "NanoVDB::nanovdb;OpenVDB::openvdb")
    endif()
    set(OpenVDB_nanovdb_FOUND TRUE)
  else()
    set(OpenVDB_nanovdb_FOUND FALSE)
  endif()
endif()

check_required_components(OpenVDB)
